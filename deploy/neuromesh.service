[Unit]
Description=NeuroMesh P2P AI Network
Documentation=https://github.com/NeuroMesh-ai/neuromesh
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=neuromesh
Group=neuromesh
WorkingDirectory=/opt/neuromesh
ExecStart=/usr/local/bin/neuromesh serve --config /etc/neuromesh/config.json
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Environment
Environment=OLLAMA_HOST=127.0.0.1:11434
EnvironmentFile=-/etc/neuromesh/env

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/neuromesh /var/log/neuromesh /run/neuromesh
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neuromesh

[Install]
WantedBy=multi-user.target